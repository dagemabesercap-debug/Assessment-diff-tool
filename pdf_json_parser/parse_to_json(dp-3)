package main

import (
	"encoding/json"
	"fmt"
	"math"
	"os"
	"regexp"
	"sort"
	"strings"

	"github.com/dslipak/pdf"
)

type Option struct {
	Text    string `json:"text"`
	Checked bool   `json:"checked"`
}

type Evidence struct {
	Text    string `json:"text"`
	Checked bool   `json:"checked"`
}
type ParsedQuestion struct {
	Q      Question
	StartY float64
	EndY   float64
}
type Question struct {
	Number       string     `json:"number"`
	Text         string     `json:"text"`
	Category     string     `json:"category"`
	Score        string     `json:"score,omitempty"`
	Options      []Option   `json:"options"`
	Evidence     []Evidence `json:"evidence"`
	Attachments  []string   `json:"attachments"`
	FreeResponse string     `json:"freeresponse,omitempty"`
	Comments     string     `json:"comments,omitempty"`
}

type TextElement struct {
	Text string
	X    float64
	Y    float64
}

type PageData struct {
	LeftCol  []TextElement
	RightCol []TextElement
}

func main() {
	files := []string{
		"Serent Capital - Studio Designer (2025).pdf",
		"Serent Capital - Studio Designer (2026).pdf",
	}

	for _, file := range files {
		outputPath := file + ".json"
		fmt.Printf("Parsing %s to JSON...\n", file)
		questions, err := parsePDF("../" + file)
		if err != nil {
			fmt.Printf("Error parsing %s: %v\n", file, err)
			continue
		}

		jsonData, err := json.MarshalIndent(questions, "", "  ")
		if err != nil {
			fmt.Printf("Error marshalling JSON: %v\n", err)
			continue
		}

		err = os.WriteFile(outputPath, jsonData, 0644)
		if err != nil {
			fmt.Printf("Error writing output file: %v\n", err)
			continue
		}
		fmt.Printf("Saved %d questions to %s\n", len(questions), outputPath)
	}
}

func parsePDF(path string) ([]Question, error) {
	r, err := pdf.Open(path)
	if err != nil {
		return nil, err
	}

	var questions []Question
	currentCategory := "COMPANY INFORMATION"
	numPages := r.NumPage()

	qNumRegex := regexp.MustCompile(`^(\d+)\.\s+([A-Za-z].*)`)

	for pageNum := 1; pageNum <= numPages; pageNum++ {
		page := r.Page(pageNum)
		if page.V.IsNull() {
			continue
		}

		// Group and sort text elements
		var elements []TextElement
		for _, t := range page.Content().Text {
			// Filter out header/footer
			if t.Y > 760 || t.Y < 40 {
				continue
			}
			elements = append(elements, TextElement{
				Text: t.S,
				X:    t.X,
				Y:    t.Y,
			})
		}

		// fmt.Print(elements)

		// Group elements into visual lines by Y coordinate (tolerance 3.5 points)
		var lines [][]TextElement
		for _, el := range elements {
			found := false
			for i, line := range lines {
				if math.Abs(line[0].Y-el.Y) < 4.5 {
					lines[i] = append(line, el)
					found = true
					break
				}
			}
			if !found {
				lines = append(lines, []TextElement{el})
			}
		}

		// fmt.Print(lines)

		// Sort lines by Y descending (top of page to bottom)
		sort.Slice(lines, func(i, j int) bool {
			return lines[i][0].Y > lines[j][0].Y
		})

		// Separate each line into Left and Right column
		var leftColumnText []TextElement
		var rightColumnText []TextElement

		for _, line := range lines {
			// Sort line elements by X ascending (left to right)
			sort.Slice(line, func(i, j int) bool {
				return line[i].X < line[j].X
			})

			var leftText, rightText string
			var leftX, rightX float64
			leftX = -1
			rightX = -1

			for _, el := range line {
				if el.X < 200 {
					if leftX == -1 {
						leftX = el.X
					}
					leftText += el.Text
				} else {
					if rightX == -1 {
						rightX = el.X
					}
					rightText += el.Text
				}
			}

			leftText = strings.TrimSpace(leftText)
			rightText = strings.TrimSpace(rightText)

			if len(leftText) > 0 {
				leftColumnText = append(leftColumnText, TextElement{
					Text: leftText,
					X:    leftX,
					Y:    line[0].Y,
				})
			}
			if len(rightText) > 0 {
				rightColumnText = append(rightColumnText, TextElement{
					Text: rightText,
					X:    rightX,
					Y:    line[0].Y,
				})
			}
		}
		// fmt.Print(leftColumnText)
		// fmt.Print(rightColumnText)

		// Track category headers in the left column
		for _, el := range leftColumnText {
			txt := strings.ToUpper(el.Text)
			if txt == "ORGANIZATION AND PLANNING" || txt == "TECHNICAL AND TOOLING" || txt == "SECURE PROCESS" || txt == "RECURRING HYGIENE" || txt == "COMPANY INFORMATION" || txt == "SECURITY TOOLS" {
				currentCategory = el.Text
			}
		}

		// Parse Questions on this page from Left Column
		var pageQuestions []Question
		var commentsBlock []TextElement
		inComments := false

		for _, el := range leftColumnText {
			if strings.HasPrefix(el.Text, "RESPONDENT COMMENTS") {
				inComments = true
				continue
			}

			matches := qNumRegex.FindStringSubmatch(el.Text)
			if matches != nil {
				inComments = false
				qNum := matches[1]
				qText := matches[2]

				// Clean up trailing scores like "4.4" or "N/A" or "Not Scored" or "Score: 64"
				// Let's extract the score if present at the end
				score := ""
				// Look for score at the end of the text
				scoreRegex := regexp.MustCompile(`(Score:\s*\d+|Not Scored|N/A|\d+\.\d+)$`)
				scoreMatch := scoreRegex.FindString(qText)
				if scoreMatch != "" {
					score = strings.TrimSpace(scoreMatch)
					qText = strings.TrimSpace(qText[:len(qText)-len(scoreMatch)])
				}

				pageQuestions = append(pageQuestions, Question{
					Number:   qNum,
					Text:     strings.TrimSpace(qText),
					Category: currentCategory,
					Score:    score,
				})
			} else if inComments {
				commentsBlock = append(commentsBlock, el)
			}
		}

		if len(pageQuestions) == 0 {
			continue
		}

		// Assign checkbox options, evidence, and attachments from Right Column
		// We align them based on the Y coordinate of the questions.
		// For a question i at Y_i, its controls lie between Y_i and Y_{i+1}
		for i := 0; i < len(pageQuestions); i++ {
			q := &pageQuestions[i]

			// Find Y bounds for this question
			// Start Y is the question's Y coordinate (or a bit higher to catch elements at the same height)
			var startY float64
			// Let's find the original Y coordinate for this question
			for _, el := range leftColumnText {
				if strings.HasPrefix(el.Text, q.Number+".") {
					startY = el.Y
					break
				}
			}

			var endY float64
			if i < len(pageQuestions)-1 {
				// Find next question's Y
				nextNum := pageQuestions[i+1].Number
				for _, el := range leftColumnText {
					if strings.HasPrefix(el.Text, nextNum+".") {
						endY = el.Y
						break
					}
				}
			} else {
				endY = 0 // bottom of page
			}

			// Extract all right column elements within Y bounds
			var qElements []TextElement
			for _, re := range rightColumnText {
				// Use a small buffer of 5 points above startY to capture aligned elements
				if re.Y <= (startY+5.0) && re.Y > endY {
					qElements = append(qElements, re)
				}
			}

			// Process right column elements
			var currentOptionText string
			var optionChecked bool
			var inOption bool

			var currentEvidenceText string
			var evidenceChecked bool
			var inEvidence bool

			for _, qe := range qElements {
				txt := qe.Text

				// Detect Attachment
				if strings.HasPrefix(txt, "") || strings.HasPrefix(txt, "Attachment:") {
					cleanTxt := strings.TrimPrefix(txt, "")
					cleanTxt = strings.TrimPrefix(cleanTxt, "Attachment:")
					cleanTxt = strings.TrimSpace(cleanTxt)
					if cleanTxt != "" {
						// Split by comma for multiple files
						files := strings.Split(cleanTxt, ",")
						for _, f := range files {
							q.Attachments = append(q.Attachments, strings.TrimSpace(f))
						}
					}
					continue
				}

				// Free-Form response (for non-checkbox questions)
				if strings.HasPrefix(txt, "Free-Form Response:") {
					resp := strings.TrimPrefix(txt, "Free-Form Response:")
					resp = strings.TrimSpace(resp)
					if resp != "" {
						q.Comments = resp
					}
					continue
				}

				// Detect standard checkbox option or evidence checkbox
				// Options start with  (checked) or  (unchecked)
				isOptChecked := strings.HasPrefix(txt, "")
				isOptUnchecked := strings.HasPrefix(txt, "")

				if isOptChecked || isOptUnchecked {
					// Save previous option or evidence if active
					if inOption {
						q.Options = append(q.Options, Option{
							Text:    strings.TrimSpace(currentOptionText),
							Checked: optionChecked,
						})
						inOption = false
					}
					if inEvidence {
						q.Evidence = append(q.Evidence, Evidence{
							Text:    strings.TrimSpace(currentEvidenceText),
							Checked: evidenceChecked,
						})
						inEvidence = false
					}

					cleanText := txt[3:] // strip the checkbox symbol (3 bytes in UTF-8)
					cleanText = strings.TrimSpace(cleanText)

					if strings.HasPrefix(cleanText, "Required evidence:") || strings.HasPrefix(cleanText, "Required Evidence:") {
						inEvidence = true
						evidenceChecked = isOptChecked
						currentEvidenceText = strings.TrimPrefix(cleanText, "Required evidence:")
						currentEvidenceText = strings.TrimPrefix(currentEvidenceText, "Required Evidence:")
					} else {
						inOption = true
						optionChecked = isOptChecked
						currentOptionText = cleanText
					}
				} else {
					// Continuation of text
					if inEvidence {
						currentEvidenceText += " " + txt
					} else if inOption {
						currentOptionText += " " + txt
					} else if len(q.Options) == 0 && len(q.Evidence) == 0 {
						// If no option started yet, it could be a free-form response text continuation
						if q.Comments != "" {
							q.Comments += " " + txt
						} else {
							q.Comments = txt
						}
					}
				}
			}

			// Save trailing option/evidence
			if inOption {
				q.Options = append(q.Options, Option{
					Text:    strings.TrimSpace(currentOptionText),
					Checked: optionChecked,
				})
			}
			if inEvidence {
				q.Evidence = append(q.Evidence, Evidence{
					Text:    strings.TrimSpace(currentEvidenceText),
					Checked: evidenceChecked,
				})
			}

			// Align comments for this question
			// Comments are in the Left column on the page, appearing below the question text and above the next question
			var qComments []string
			for _, ce := range commentsBlock {
				if ce.Y <= (startY+5.0) && ce.Y > endY {
					qComments = append(qComments, ce.Text)
				}
			}
			if len(qComments) > 0 {
				joinedComments := strings.Join(qComments, " ")
				joinedComments = strings.TrimPrefix(joinedComments, "-")
				joinedComments = strings.TrimSpace(joinedComments)
				if q.Comments != "" {
					q.Comments += "\n" + joinedComments
				} else {
					q.Comments = joinedComments
				}
			}
		}

		questions = append(questions, pageQuestions...)
	}

	// Clean up question list:
	// For free-form questions, if we captured parts of page layout or "Not Scored" in text, clean it up.
	for i := range questions {
		q := &questions[i]
		fmt.Print(q)
		// Clean up comments from page artifacts
		q.Comments = strings.TrimSpace(q.Comments)
		// Clean up question text from extra whitespaces
		q.Text = strings.TrimSpace(q.Text)
	}

	return questions, nil
}
