# Bind the application to 127.0.0.1 for SSM/SSH tunneling. Set to 0.0.0.0
# only when the EC2 security group restricts access to trusted VPC/VPN CIDRs.
APP_BIND_IP=127.0.0.1
APP_PORT=8090
NOVNC_PORT=6080

# Required for the browser sign-in console. Use a long unique value and keep
# the real .env file out of source control.
VNC_PASSWORD=replace-with-a-long-random-password
