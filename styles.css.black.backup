/* Premium Dark-Mode CSS Theme with Glassmorphism and Backdrop Filters */
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

:root {
  --bg-color: #f8fafc;
  --panel-bg: rgba(248, 250, 252, 0.85);
  --panel-border: rgba(255, 255, 255, 0.08);
  --panel-border-hover: rgba(14, 165, 233, 0.3);
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --text-muted: #6b7280;
  
  /* Accent Colors */
  --primary: #0ea5e9;
  --primary-gradient: linear-gradient(135deg, #0ea5e9, #38bdf8);
  --success: #10b981;
  --success-bg: rgba(16, 185, 129, 0.1);
  --danger: #f43f5e;
  --danger-bg: rgba(244, 63, 94, 0.1);
  --warning: #f59e0b;
  --warning-bg: rgba(245, 158, 11, 0.1);
  --info: #3b82f6;
  --info-gradient: linear-gradient(135deg, #3b82f6, #60a5fa);
  
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --shadow-lg: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
  --shadow-glow: 0 0 20px rgba(124, 58, 237, 0.15);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-color);
  color: var(--text-primary);
  font-family: var(--font-sans);
  min-height: 100vh;
  overflow-x: hidden;
  line-height: 1.5;
  background-image: 
    radial-gradient(circle at 10% 20%, rgba(124, 58, 237, 0.08) 0%, transparent 40%),
    radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.08) 0%, transparent 40%);
  background-attachment: fixed;
}

/* Glassmorphism Panel Base */
.glass-panel {
  background: var(--panel-bg);
  border: 1px solid var(--panel-border);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 16px;
  box-shadow: var(--shadow-lg);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.glass-panel:hover {
  border-color: var(--panel-border-hover);
  box-shadow: var(--shadow-lg), var(--shadow-glow);
}

/* Layout */
.dashboard-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 24px;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.logo-section h1 {
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: #0ea5e9;
  background: none;
  -webkit-background-clip: initial;
  -webkit-text-fill-color: transparent;
}

.logo-section p {
  color: var(--text-secondary);
  font-size: 14px;
  margin-top: 4px;
}

/* Hero Score Section */
.hero-grid {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 24px;
  margin-bottom: 32px;
}

.score-widget {
  padding: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.score-widget::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.05) 0%, transparent 60%);
  pointer-events: none;
}

.gauge-container {
  position: relative;
  width: 200px;
  height: 200px;
  margin-bottom: 20px;
}

.gauge-svg {
  transform: rotate(-90deg);
  width: 100%;
  height: 100%;
}

.gauge-bg {
  fill: none;
  stroke: rgba(255, 255, 255, 0.03);
  stroke-width: 14;
}

.gauge-progress {
  fill: none;
  stroke: url(#gaugeGradient);
  stroke-width: 14;
  stroke-linecap: round;
  transition: stroke-dashoffset 1s ease-in-out;
}

.gauge-value {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.gauge-number {
  font-size: 48px;
  font-weight: 800;
  line-height: 1;
  color: #0ea5e9;
  background: none;
  -webkit-background-clip: initial;
  -webkit-text-fill-color: transparent;
}

.gauge-label {
  font-size: 12px;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-top: 4px;
}

.delta-badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 12px;
  border-radius: 99px;
  font-weight: 700;
  font-size: 14px;
  gap: 4px;
}

.delta-badge.negative {
  background-color: var(--danger-bg);
  color: var(--danger);
  border: 1px solid rgba(244, 63, 94, 0.2);
}

.delta-badge.positive {
  background-color: var(--success-bg);
  color: var(--success);
  border: 1px solid rgba(16, 185, 129, 0.2);
}

.score-meta {
  margin-top: 16px;
  display: flex;
  gap: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  padding-top: 16px;
  width: 100%;
  justify-content: center;
}

.score-meta-item span {
  display: block;
  font-size: 11px;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.score-meta-item strong {
  font-size: 20px;
  font-weight: 700;
}

/* Category Grid */
.categories-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.category-card {
  padding: 20px;
  cursor: pointer;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.category-card.active {
  border-color: var(--primary);
  background: rgba(124, 58, 237, 0.08);
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.category-title {
  font-size: 15px;
  font-weight: 700;
  letter-spacing: -0.2px;
}

.category-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.03);
  color: var(--text-secondary);
}

.category-card.active .category-icon {
  background: var(--primary);
  color: #fff;
}

.category-scores {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.category-numbers {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.cat-score-current {
  font-size: 28px;
  font-weight: 800;
}

.cat-score-prev {
  font-size: 14px;
  color: var(--text-secondary);
  text-decoration: line-through;
}

/* Filter Bar */
.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  gap: 16px;
  padding: 16px 20px;
}

.search-container {
  position: relative;
  flex: 1;
  max-width: 400px;
}

.search-input {
  width: 100%;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--panel-border);
  padding: 10px 16px 10px 40px;
  border-radius: 99px;
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 14px;
  transition: all 0.3s;
}

.search-input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 10px rgba(124, 58, 237, 0.1);
}

.search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  pointer-events: none;
}

.filter-groups {
  display: flex;
  gap: 8px;
}

.filter-btn {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--panel-border);
  padding: 8px 16px;
  border-radius: 99px;
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.filter-btn:hover {
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-primary);
}

.filter-btn.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

/* Aligned Tree / Question list */
.tree-container {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.question-node {
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid var(--panel-border);
  transition: all 0.3s;
}

.question-node:hover {
  border-color: rgba(255, 255, 255, 0.15);
}

.question-header-bar {
  padding: 20px 24px;
  cursor: pointer;
  background: rgba(255, 255, 255, 0.01);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  user-select: none;
}

.question-node.expanded .question-header-bar {
  background: rgba(255, 255, 255, 0.02);
  border-bottom: 1px solid var(--panel-border);
}

.question-num-title {
  display: flex;
  align-items: center;
  gap: 16px;
  flex: 1;
}

.question-number-badge {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.03);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 16px;
  border: 1px solid var(--panel-border);
  flex-shrink: 0;
}

.question-node.regression .question-number-badge {
  color: var(--danger);
  border-color: rgba(244, 63, 94, 0.2);
  background: var(--danger-bg);
}

.question-node.improvement .question-number-badge {
  color: var(--success);
  border-color: rgba(16, 185, 129, 0.2);
  background: var(--success-bg);
}

.question-title-text {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
}

.question-meta-badges {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.q-badge {
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.q-badge.new {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
  animation: glowPulse 2s infinite alternate;
}

.q-badge.category {
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-secondary);
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.q-score-delta-val {
  font-weight: 700;
  font-size: 14px;
}

.q-score-delta-val.neg {
  color: var(--danger);
}

.q-score-delta-val.pos {
  color: var(--success);
}

.chevron-icon {
  color: var(--text-muted);
  transition: transform 0.3s;
}

.question-node.expanded .chevron-icon {
  transform: rotate(180deg);
}

/* Expandable content details */
.question-details {
  display: none;
  padding: 24px;
  background: rgba(0, 0, 0, 0.15);
}

.question-node.expanded .question-details {
  display: block;
}

.side-by-side-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px;
  position: relative;
}

.side-by-side-grid::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1px;
  background: rgba(255, 255, 255, 0.05);
}

.col-header {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--text-secondary);
  margin-bottom: 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  padding-bottom: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.col-header .col-score {
  font-weight: 800;
  font-size: 14px;
  color: var(--text-primary);
}

/* Checklist items diffing */
.checklist-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.check-item {
  display: flex;
  gap: 12px;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 13px;
  border: 1px solid transparent;
  align-items: flex-start;
}

.check-item.status-unchanged {
  background: rgba(255, 255, 255, 0.01);
  color: var(--text-secondary);
}

.check-item.status-added {
  background: var(--success-bg);
  border-color: rgba(16, 185, 129, 0.15);
  color: var(--text-primary);
}

.check-item.status-removed {
  background: var(--danger-bg);
  border-color: rgba(244, 63, 94, 0.15);
  color: var(--text-secondary);
  text-decoration: line-through;
}

.check-symbol {
  font-size: 16px;
  line-height: 1;
  flex-shrink: 0;
}

.check-item.status-unchanged .check-symbol {
  color: var(--text-muted);
}
.check-item.status-added .check-symbol {
  color: var(--success);
}
.check-item.status-removed .check-symbol {
  color: var(--danger);
}

.diff-tag {
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  padding: 2px 6px;
  border-radius: 4px;
  margin-left: auto;
  flex-shrink: 0;
}

.diff-tag.added {
  background: var(--success);
  color: #000;
}

.diff-tag.removed {
  background: var(--danger);
  color: #fff;
}

/* Comments & Evidence attachment blocks */
.metadata-blocks {
  margin-top: 24px;
  grid-column: span 2;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  padding-top: 20px;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.meta-block-card {
  padding: 16px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.04);
}

.meta-block-title {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-secondary);
  letter-spacing: 0.5px;
  margin-bottom: 10px;
}

.meta-block-content {
  font-size: 13px;
  color: var(--text-primary);
  white-space: pre-wrap;
}

.meta-block-content.empty {
  color: var(--text-muted);
  font-style: italic;
}

/* Attachments links */
.attachment-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 6px;
}

.attachment-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.05);
  font-size: 12px;
  color: var(--text-secondary);
  text-decoration: none;
  transition: all 0.2s;
}

.attachment-chip:hover {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-primary);
  border-color: var(--primary);
}

/* General scrollbars */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-color);
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 99px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--primary);
}

/* Animations */
@keyframes glowPulse {
  0% { box-shadow: 0 0 5px rgba(139, 92, 246, 0.4); }
  100% { box-shadow: 0 0 15px rgba(236, 72, 153, 0.8); }
}

/* Responsive */
@media (max-width: 1024px) {
  .hero-grid {
    grid-template-columns: 1fr;
  }
  
  .side-by-side-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  
  .side-by-side-grid::after {
    display: none;
  }
  
  .meta-grid {
    grid-template-columns: 1fr;
  }
}
